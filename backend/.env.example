# Database Configuration
# Copy this file to .env and update with your actual database credentials

# PostgreSQL Database URL
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/iv1201_db

# JWT Configuration
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application Settings
APP_NAME=IV1201 Recruitment Application
APP_VERSION=1.0.0
DEBUG=True

# CORS Settings
CORS_ORIGINS=http://localhost:5173

# Mail Configuration (for development/testing)
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=user@smtp-example.com
MAIL_PASSWORD=password
MAIL_FROM=jane.doe@example.com

# Brevo HTTP API (recommended for production)
BREVO_API_KEY=your-brevo-api-key
BREVO_SENDER_NAME=IV1201